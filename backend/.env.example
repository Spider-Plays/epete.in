NODE_ENV=development
PORT=5000
# Local Docker Postgres. On Neon, use the pooled URL here and the direct URL for DIRECT_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epete?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/epete?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=http://localhost:3000
